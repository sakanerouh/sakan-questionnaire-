# Supabase
# Example: SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose in the browser. Prefer the current sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
# Set to true only in local development to allow the built-in demo unlock flow
# when Stripe checkout credentials are blank. It is always disabled in production.
ENABLE_DEMO_UNLOCK=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-5.5
